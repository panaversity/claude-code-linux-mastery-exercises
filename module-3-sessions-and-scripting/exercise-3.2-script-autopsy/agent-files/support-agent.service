[Unit]
Description=Customer Support Agent
Documentation=https://docs.example.com/support-agent
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=supportagent
Group=supportagent
WorkingDirectory=/opt/customer-support-agent
ExecStart=/usr/bin/python3 /opt/customer-support-agent/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=customer-support-agent

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/customer-support-agent

# Environment
Environment=CONFIG_PATH=/etc/customer-support-agent/config.yaml
Environment=LOG_DIR=/var/log/customer-support-agent
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
