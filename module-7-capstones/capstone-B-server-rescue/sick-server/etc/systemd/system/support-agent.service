[Unit]
Description=Customer Support Agent
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=support
Group=support
WorkingDirectory=/opt/support-agent
ExecStart=/usr/bin/python3 /opt/support-agent/main.py
EnvironmentFile=/etc/support-agent/agent.env

# Logging
StandardOutput=append:/var/log/support-agent/access.log
StandardError=append:/var/log/support-agent/error.log

# Restart policy
Restart=always
RestartSec=0
# Note: Changed from RestartSec=5 to RestartSec=0 on Feb 9
# "for faster recovery" -- admin's comment in bash history

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/support-agent /var/lib/support-agent

[Install]
WantedBy=multi-user.target
