-- This is a placeholder representing a SQLite database file.
-- In a real deployment, this would be a binary SQLite database.
--
-- PROBLEM: This database is stored in /root/ which means:
-- 1. Only root can access it (the agent service may not run as root)
-- 2. It violates the principle of least privilege
-- 3. Application data should be in /var/lib/agent-app/
-- 4. The agent user should own the data directory
--
-- Schema:
-- CREATE TABLE summaries (
--     id INTEGER PRIMARY KEY AUTOINCREMENT,
--     input_hash TEXT UNIQUE NOT NULL,
--     input_text TEXT NOT NULL,
--     summary TEXT NOT NULL,
--     model TEXT NOT NULL,
--     tokens_used INTEGER,
--     created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
-- );
--
-- Contains 47 summary records accumulated over 2 weeks of operation.
