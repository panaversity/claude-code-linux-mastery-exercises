[Unit]
Description=Summarizer Agent - AI text summarization service
After=network-online.target

[Service]
Type=simple
# BAD: No dedicated user - will run as whoever starts it (probably root)
# Should have User=agentapp and Group=agentapp
WorkingDirectory=/tmp/agent-app
ExecStart=/usr/bin/python3 /tmp/agent-app/main.py
Restart=on-failure

# BAD: Environment file in admin's home directory
EnvironmentFile=/home/admin/.env

# BAD: No hardening directives at all
# Missing: NoNewPrivileges, ProtectSystem, ReadWritePaths

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
