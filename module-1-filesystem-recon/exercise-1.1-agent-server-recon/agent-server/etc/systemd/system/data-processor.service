[Unit]
Description=Data Processor - Batch data pipeline agent
Documentation=https://internal.wiki/agents/data-processor
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=dataproc
Group=dataproc
WorkingDirectory=/opt/data-processor
ExecStart=/usr/bin/python3 /opt/data-processor/processor.py --config /etc/data-processor/pipeline.yaml
StandardOutput=append:/var/log/data-processor/pipeline.log
StandardError=append:/var/log/data-processor/pipeline.log

EnvironmentFile=/opt/data-processor/.env

# Allow long batch runs
TimeoutStartSec=3600

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/data-processor /var/log/data-processor

[Install]
WantedBy=multi-user.target
