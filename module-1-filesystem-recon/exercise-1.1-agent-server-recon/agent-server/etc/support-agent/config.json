{
  "server": {
    "host": "0.0.0.0",
    "port": 8002,
    "cors_origins": ["https://support.example.com", "https://admin.example.com"]
  },
  "llm": {
    "model": "gpt-4",
    "max_tokens": 2048,
    "temperature": 0.7,
    "system_prompt_path": "/opt/support-agent/prompts/system.txt"
  },
  "knowledge_base": {
    "path": "/opt/support-agent/kb/",
    "index_type": "faiss",
    "embedding_model": "text-embedding-3-small",
    "chunk_size": 512
  },
  "session": {
    "store": "redis",
    "redis_url": "redis://localhost:6379/1",
    "ttl_seconds": 1800,
    "cache_dir": "/tmp/support-agent-cache"
  },
  "logging": {
    "level": "INFO",
    "file": "/var/log/support-agent/combined.log",
    "format": "json"
  },
  "rate_limiting": {
    "enabled": true,
    "requests_per_minute": 60,
    "burst": 10
  }
}
