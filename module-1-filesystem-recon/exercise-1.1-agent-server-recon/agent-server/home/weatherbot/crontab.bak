# Backup of weatherbot crontab
# Backed up: 2026-01-05 before switching to systemd timer
# These were the old cron entries:

# Fetch weather data every 5 minutes
*/5 * * * * /usr/bin/python3 /opt/weather-bot/main.py --fetch-only >> /var/log/weather-bot/cron.log 2>&1

# Daily log rotation at midnight
0 0 * * * /usr/sbin/logrotate /etc/logrotate.d/weather-bot

# Weekly cache cleanup
0 3 * * 0 /opt/weather-bot/scripts/clear-cache.sh

# NOTE: All of these are now handled by systemd timers
# See: weather-bot.timer, logrotate.timer
# This file kept for reference only - DO NOT re-enable
