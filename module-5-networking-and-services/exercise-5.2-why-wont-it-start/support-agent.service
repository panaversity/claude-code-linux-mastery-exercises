[Unit]
Description=Customer Support Agent
After=network.target

[Service]
User=supportagent
WorkingDirectory=/opt/support-agent
ExecStart=/opt/support-agent/venv/bin/python main.py
EnvironmentFile=/etc/support-agent/agent.env
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=support-agent

MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
