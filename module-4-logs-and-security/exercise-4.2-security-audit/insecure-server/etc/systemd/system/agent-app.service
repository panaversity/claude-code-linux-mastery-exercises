[Unit]
Description=AI Support Agent Application
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service
Documentation=https://wiki.internal.company.com/agent-app

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/agent-app
ExecStart=/opt/agent-app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --workers 4
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=append:/var/log/agent-app/access.log
StandardError=append:/var/log/agent-app/error.log

# Environment
EnvironmentFile=/opt/agent-app/.env

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# No security hardening configured
# TODO: Add sandboxing when we have time
#ProtectSystem=strict
#ProtectHome=true
#PrivateTmp=true
#NoNewPrivileges=true
#ReadWritePaths=/var/log/agent-app

[Install]
WantedBy=multi-user.target
